
cd "$SRC"

wget https://github.com/ArtsyMacaw/wlogout/releases/download/1.2.2/wlogout.tar.gz

rm -rf wlogout

tar xf wlogout.tar.gz --one-top-level=wlogout

cd wlogout

meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release > "$LOG/wlogout.log" 2>&1

ninja -C build -j$JOBS >> "$LOG/wlogout.log" 2>&1

ninja -C build install >> "$LOG/wlogout.log" 2>&1

ldconfig

