
cd "$SRC"

wget -q --show-progress https://downloads.sourceforge.net/pcmanfm/libfm-1.3.2.tar.xz

rm -rf libfm-1.3.2

tar -xf libfm-1.3.2.tar.xz

cd libfm-1.3.2

CFLAGS="-Wno-error=incompatible-pointer-types" ./configure --prefix=/usr       \
            --sysconfdir=/etc   \
            --with-extra-only   \
            --disable-static    \
            --with-gtk=3 > "$LOG/libfm-1.log" 2>&1

make >> "$LOG/libfm-1.log" 2>&1

make install >> "$LOG/libfm-1.log" 2>&1

