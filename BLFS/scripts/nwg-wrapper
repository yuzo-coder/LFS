
cd "$SRC"

wget https://github.com/nwg-piotr/nwg-wrapper/archive/refs/tags/v0.1.3.tar.gz

rm -rf nwg-wrapper-0.1.3

tar -xf v0.1.3.tar.gz

cd nwg-wrapper-0.1.3/

SITE_PACKAGES="$(python3 -c "import sysconfig; print(sysconfig.get_paths()['purelib'])")"

cp -r nwg_wrapper "$SITE_PACKAGES/"

cat > /usr/bin/nwg-wrapper << "EOF"
#!/usr/bin/env python3
import sys
from nwg_wrapper.main import main
if __name__ == '__main__':
    sys.exit(main())
EOF

chmod +x /usr/bin/nwg-wrapper

mkdir -p /usr/share/nwg-wrapper

cp -r examples/ /usr/share/nwg-wrapper/

install -Dm 644 -t "/usr/share/licenses/nwg-wrapper" LICENSE

install -Dm 644 -t "/usr/share/doc/nwg-wrapper" README.md
