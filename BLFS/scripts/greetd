
cd "$SRC"

wget -q --show-progress https://github.com/kennylevinsen/greetd/archive/refs/tags/0.10.2.tar.gz

rm -rf greetd-0.10.2

tar -xf 0.10.2.tar.gz

cd greetd-0.10.2

cargo build --release --locked > "$LOG/greetd.log" 2>&1

cp -f target/release/greetd /usr/bin/

cp -f "$SRC/greetd-0.10.2/greetd.service" /etc/systemd/system/

