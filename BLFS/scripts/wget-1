
cd "$SRC"

rm -rf wget-1.25.0

tar xf wget-1.25.0.tar.gz  # zオプションはなくてもtarが自動判別します

cd wget-1.25.0

./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-ssl=openssl \
    > "$LOG/wget.log" 2>&1

make -j"$JOBS" 2>&1 | tee -a "$LOG/wget.log"

make install 2>&1 | tee -a "$LOG/wget.log"


