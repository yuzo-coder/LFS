
cd "$SRC"

wget -q --show-progress https://ftp.gnu.org/gnu/gdb/gdb-16.3.tar.xz

rm -rf gdb-16.3

tar -xf gdb-16.3.tar.xz

cd gdb-16.3

export CXXFLAGS="${CXXFLAGS:-} -fpermissive -D_GLIBCXX_HAVE_STDBOOL_H -DNCURSES_BOOL=bool"

export CPPFLAGS="${CPPFLAGS:-} -DNCURSES_NOMACROS"

./configure --prefix=/usr \
            --with-system-readline \
            --with-python=/usr/bin/python3 \
            --disable-source-highlight > "$LOG/gdb.log" 2>&1

make >> "$LOG/gdb.log" 2>&1


make install >> "$LOG/gdb.log" 2>&1


