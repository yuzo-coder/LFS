
cd "$SRC"

wget -q --show-progress https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.5.0.tar.gz

tar -xf libwebp-1.5.0.tar.gz

cd libwebp-1.5.0

./configure --prefix=/usr           \
            --enable-everything      \
            --enable-libwebpdemux    \
            --enable-libwebpmux      \
            --enable-libwebpdecoder  \
            --disable-static > "$LOG/libwebp.log" 2>&1

make >> "$LOG/libwebp.log" 2>&1

make install >> "$LOG/libwebp.log" 2>&1

