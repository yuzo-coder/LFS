
cd "$SRC"

rm -rf SPIRV-LLVM-Translator-20.1.5

wget -q --show-progress https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v20.1.5/SPIRV-LLVM-Translator-20.1.5.tar.gz

tar -xf SPIRV-LLVM-Translator-20.1.5.tar.gz

cd SPIRV-LLVM-Translator-20.1.5

mkdir build && cd build

cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release ..  > "$LOG/SPIRV-LLVM-Translator.log" 2>&1

make >> "$LOG/SPIRV-LLVM-Translator.log" 2>&1

make install > "$LOG/SPIRV-LLVM-Translator.log" 2>&1


