
cd "$SRC"

wget -q --show-progress https://ftp2.osuosl.org/pub/blfs/12.4/l/libtirpc-1.3.6.tar.bz2

rm -rf libtirpc-1.3.6

tar -xf libtirpc-1.3.6.tar.bz2

cd libtirpc-1.3.6

wget -q --show-progress https://www.linuxfromscratch.org/patches/blfs/12.4/libtirpc-1.3.6-gcc15_fixes-1.patch

# 2. パッチを適用
# -N はパッチ内のディレクトリ構成を無視せず適用、-p1 はディレクトリの階層を1つ飛ばす設定です
patch -Np1 -i libtirpc-1.3.6-gcc15_fixes-1.patch

# 3. GSSAPIチェックの無効化（ここはパッチに含まれていないため、引き続き必要です）
sed -i 's/gssapi_header=yes/gssapi_header=no/' configure

sed -i 's/has_gssapi=yes/has_gssapi=no/' configure

GSSAPI_CFLAGS=" " GSSAPI_LIBS=" " \
./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --disable-static --disable-gssapi > "$LOG"/libtirpc.log 2>&1

make >> "$LOG"/libtirpc.log 2>&1

make install >> "$LOG"/libtirpc.log 2>&1

