
DIR=$(download_extract "https://archive.mozilla.org/pub/nspr/releases/v4.35/src/nspr-4.35.tar.gz")

cd "$DIR/nspr"

./configure --prefix=/usr \
            --with-mozilla \
            --with-pthreads \
            $([ $(uname -m) = x86_64 ] && echo --enable-64bit) > "$LOG/nspr.log" 2>&1
make >> "$LOG/nspr.log" 2>&1

make install >> "$LOG/nspr.log" 2>&1

