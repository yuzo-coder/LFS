
build_meson "mpv" \
    "https://ftp2.osuosl.org/pub/blfs/12.4/m/mpv-0.40.0.tar.gz" \
    "-Dalsa=enabled \
    -Dpulse=enabled \
    -Dpipewire=enabled \
    -Dwayland=enabled \
    -Dx11=enabled \
    -Dlua=enabled \
    --libdir=/usr/lib \
    -Dlibmpv=true \
    -Djavascript=disabled"

echo "mpv --vo=gpu /pathtovideo "

