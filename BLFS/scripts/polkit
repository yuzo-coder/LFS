
groupadd -g 27 polkitd &&

useradd -c "PolicyKit Daemon User" -d /var/lib/polkit -u 27 -g polkitd -s /bin/false polkitd

mkdir -p /var/lib/polkit

chown -v polkitd:polkitd /var/lib/polkit

chmod -v 750 /var/lib/polkit

build_meson "polkit" \
    "https://github.com/polkit-org/polkit/archive/refs/tags/124.tar.gz" \
    "-Dintrospection=false -Dman=false -Dexamples=false -Dgtk_doc=false -Dtests=false -Dsystemdsystemunitdir=/lib/systemd/system"

cat > /lib/systemd/system/polkit.service << "EOF"
[Unit]
Description=Authorization Manager
After=dbus.service

[Service]
Type=dbus
BusName=org.freedesktop.PolicyKit1
ExecStart=/usr/lib/polkit-1/polkitd --no-debug
User=root

[Install]
WantedBy=multi-user.target
EOF


cat > /etc/polkit-1/rules.d/10-enable-shutdown.rules << "EOF"
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.reboot" ||
         action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
         action.id == "org.freedesktop.login1.power-off" ||
         action.id == "org.freedesktop.login1.power-off-multiple-sessions" ||
         action.id == "org.freedesktop.login1.suspend" ||
         action.id == "org.freedesktop.login1.hibernate") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
EOF

systemctl daemon-reload

systemctl start polkit

systemctl enable polkit


