
cd "$SRC"

wget https://downloads.sourceforge.net/pcmanfm/libfm-1.3.2.tar.xz

rm -rf libfm-1.3.2

tar -xf libfm-1.3.2.tar.xz

cd libfm-1.3.2

CFLAGS="-Wno-error=incompatible-pointer-types" ./configure --prefix=/usr       \
            --sysconfdir=/etc   \
            --disable-static    \
            --with-gtk=3

make 

make install

