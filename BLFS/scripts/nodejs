
cd "$SRC"

wget -q --show-progress https://nodejs.org/dist/v24.14.1/node-v24.14.1.tar.xz

tar -xf node-v24.14.1.tar.xz

cd node-v24.14.1

./configure --prefix=/usr \
            --shared-zlib \
            --shared-openssl \
            --with-intl=full-icu > "$LOG/node.log" 2>&1

make  >> "$LOG/node.log" 2>&1

make install >> "$LOG/node.log" 2>&1


