
cd "$SRC"

rm -rf libpng-1.6.45

wget -q --show-progress https://downloads.sourceforge.net/libpng/libpng-1.6.45.tar.xz

tar -xf libpng-1.6.45.tar.xz

cd libpng-1.6.45

wget -q --show-progress https://downloads.sourceforge.net/project/libpng-apng/libpng16/1.6.45/libpng-1.6.45-apng.patch.gz

gunzip libpng-1.6.45-apng.patch.gz

patch -p1 < libpng-1.6.45-apng.patch

./configure --prefix=/usr --disable-static > "$LOG/libpng.log" 2>&1

make >> "$LOG/libpng.log" 2>&1

make install >> "$LOG/libpng.log" 2>&1

ldconfig

