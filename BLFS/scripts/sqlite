
DIR=$(download_extract "https://www.sqlite.org/2024/sqlite-autoconf-3450300.tar.gz")

cd "$DIR"

./configure --prefix=/usr \
            --disable-static \
            --enable-fts5 \
            CPPFLAGS="-DSQLITE_ENABLE_COLUMN_METADATA=1 -DSQLITE_ENABLE_UNLOCK_NOTIFY=1" > "$LOG/sqlite.log" 2>&1

make >> "$LOG/sqlite.log" 2>&1

make install > "$LOG/sqlite.log" 2>&1


