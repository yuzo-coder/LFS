
LUA_DIR=$(download_extract "https://www.lua.org/ftp/lua-5.2.4.tar.gz")

cd "$LUA_DIR"

make linux MYCFLAGS="-fPIC" > "$LOG/lua.log" 2>&1

make install INSTALL_TOP="$PREFIX" >> "$LOG/lua.log" 2>&1

mkdir -p "$PREFIX/lib/pkgconfig"

cat << EOF > "$PREFIX/lib/pkgconfig/lua.pc"
V=5.2
R=5.2.4
prefix=/usr
exec_prefix=/usr
libdir=/usr/lib
includedir=/usr/include
Name: Lua
Description: An Extensible Extension Language
Version: 5.2.4
Requires:
Libs: -L/usr/lib -llua -lm -ldl
Cflags: -I/usr/include
EOF

ldconfig

