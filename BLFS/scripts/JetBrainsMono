
FONT_DIR="/usr/local/share/fonts/jetbrains"

mkdir -p $FONT_DIR

cd $SRC

wget -q --show-progress https://github.com/ryanoasis/nerd-fonts/releases/download/v3.1.1/JetBrainsMono.zip

if [ $? -eq 0 ]; then
    unzip JetBrainsMono.zip -d $FONT_DIR
    fc-cache -fv
    echo "Font installed and cache updated."
else
    echo "Failed to download fonts."
    exit 1
fi

