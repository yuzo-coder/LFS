
DIR=$(download_extract "https://www.kernel.org/pub/linux/utils/cryptsetup/v2.4/cryptsetup-2.4.3.tar.xz")

cd "$DIR"

./configure --prefix=/usr \
            --disable-static \
            --disable-ssh-token \
            --with-crypto_backend=openssl >> "$LOG/cryptsetup.log" 2>&1

make >> "$LOG/cryptsetup.log" 2>&1

make install >> "$LOG/cryptsetup.log" 2>&1

ldconfig

