. /cscripts/env.sh

cd /sources

rm -rfv linux-6.16.1

tar -xf linux-6.16.1.tar.xz

if [[ "$ULFS_COPY_KERNEL_SOURCES" == "YES" ]]
then
    cp -rv linux-6.16.1 /usr/src
fi

cd linux-6.16.1

#FORCING ARCH 
ARCH=""

make mrproper

# ---------- ここから自動config追加 ----------

make defconfig

# デバッグ（GDBステップ実行用）
scripts/config --enable CONFIG_DEBUG_KERNEL
scripts/config --enable CONFIG_DEBUG_INFO
scripts/config --enable CONFIG_DEBUG_INFO_DWARF5
scripts/config --enable CONFIG_GDB_SCRIPTS
scripts/config --enable CONFIG_FRAME_POINTER
scripts/config --enable CONFIG_KALLSYMS
scripts/config --enable CONFIG_KALLSYMS_ALL
scripts/config --enable CONFIG_MAGIC_SYSRQ
scripts/config --enable CONFIG_DEBUG_PREEMPT
scripts/config --enable CONFIG_SCHED_DEBUG
scripts/config --enable CONFIG_PRINTK

# QEMU / virtio
scripts/config --enable CONFIG_PCI
scripts/config --enable CONFIG_PCI_MSI
scripts/config --enable CONFIG_ACPI
scripts/config --enable CONFIG_X86_IO_APIC

scripts/config --enable CONFIG_VIRTIO
scripts/config --enable CONFIG_VIRTIO_PCI
scripts/config --enable CONFIG_VIRTIO_BLK
scripts/config --enable CONFIG_VIRTIO_NET
scripts/config --enable CONFIG_VIRTIO_GPU

scripts/config --enable CONFIG_NET
scripts/config --enable CONFIG_PACKET
scripts/config --enable CONFIG_UNIX

# DRM / Wayland（sway動作用）
scripts/config --enable CONFIG_DRM
scripts/config --enable CONFIG_DRM_KMS_HELPER
scripts/config --enable CONFIG_DRM_VIRTIO_GPU
scripts/config --enable CONFIG_DRM_FBDEV_EMULATION
scripts/config --enable CONFIG_DRM_SIMPLEDRM
scripts/config --enable CONFIG_FRAMEBUFFER_CONSOLE
scripts/config --enable CONFIG_FB
scripts/config --enable CONFIG_VT

# 入力系（重要）
scripts/config --enable CONFIG_INPUT
scripts/config --enable CONFIG_INPUT_EVDEV
scripts/config --enable CONFIG_INPUT_KEYBOARD
scripts/config --enable CONFIG_INPUT_MOUSE

# systemd 必須
scripts/config --enable CONFIG_DEVTMPFS
scripts/config --enable CONFIG_DEVTMPFS_MOUNT
scripts/config --enable CONFIG_TMPFS
scripts/config --enable CONFIG_TMPFS_POSIX_ACL

scripts/config --enable CONFIG_CGROUPS
scripts/config --enable CONFIG_CGROUP_BPF
scripts/config --enable CONFIG_CGROUP_FREEZER
scripts/config --enable CONFIG_CGROUP_PIDS
scripts/config --enable CONFIG_CGROUP_SCHED

scripts/config --enable CONFIG_NAMESPACES
scripts/config --enable CONFIG_USER_NS
scripts/config --enable CONFIG_SECCOMP

scripts/config --enable CONFIG_SIGNALFD
scripts/config --enable CONFIG_TIMERFD
scripts/config --enable CONFIG_EPOLL
scripts/config --enable CONFIG_INOTIFY_USER
scripts/config --enable CONFIG_FHANDLE
scripts/config --enable CONFIG_AUTOFS4_FS

# rootfs安定用
scripts/config --enable CONFIG_BLOCK
scripts/config --enable CONFIG_BLK_DEV
scripts/config --enable CONFIG_PARTITION_ADVANCED
scripts/config --enable CONFIG_MSDOS_PARTITION
scripts/config --enable CONFIG_EXT4_FS

# systemd
scripts/config --enable CONFIG_SYSVIPC
scripts/config --enable CONFIG_POSIX_MQUEUE
scripts/config --enable CONFIG_BPF
scripts/config --enable CONFIG_FANOTIFY

# フリーズ回避
scripts/config --enable CONFIG_HZ_1000
scripts/config --enable CONFIG_HIGH_RES_TIMERS
scripts/config --enable CONFIG_PREEMPT_VOLUNTARY

# 黒画面対策
scripts/config --enable CONFIG_EARLY_PRINTK
scripts/config --enable CONFIG_SERIAL_8250
scripts/config --enable CONFIG_SERIAL_8250_CONSOLE


# ネットワークブリッジ
scripts/config --enable CONFIG_BRIDGE_NETFILTER
scripts/config --enable CONFIG_VLAN_8021Q
scripts/config --enable CONFIG_NETFILTER

# VirtIO GPUの3D加速を支えるメモリ管理
scripts/config --enable CONFIG_DRM_TTM
scripts/config --enable CONFIG_DMA_SHARED_BUFFER

# コンソールからSwayに切り替える際の画面保護
scripts/config --enable CONFIG_BACKLIGHT_CLASS_DEVICE

scripts/config --enable CONFIG_VIRTIO_INPUT
scripts/config --enable CONFIG_INPUT_MOUSEDEV

# systemd-networkd や Firewall 関連
scripts/config --enable CONFIG_NET_CORE
scripts/config --enable CONFIG_IP_NF_IPTABLES
scripts/config --enable CONFIG_NET_SCHED
scripts/config --enable CONFIG_NET_CLS_BPF

# systemd のセキュリティ機能 (RestrictAddressFamilies など) に必須
scripts/config --enable CONFIG_AF_UNIX
scripts/config --enable CONFIG_IPV6

# システムの監査・ログ
scripts/config --disable CONFIG_AUDIT
scripts/config --disable CONFIG_AUDITSYSCALL

# 仮想マシンとホスト間での共有ディレクトリ用 (もし将来使うなら)
scripts/config --enable CONFIG_VIRTIO_9P
scripts/config --enable CONFIG_9P_FS

# QEMU内の乱数生成器 (起動速度の向上: Entropy不足を回避)
scripts/config --enable CONFIG_HW_RANDOM_VIRTIO

# ALSA 本体
scripts/config --enable CONFIG_SND
scripts/config --enable CONFIG_SND_OSSEMUL
scripts/config --enable CONFIG_SND_PCM_OSS
scripts/config --enable CONFIG_SND_SEQUENCER

# QEMU の intel-hda 用ドライバ
scripts/config --enable CONFIG_SND_HDA_INTEL
scripts/config --enable CONFIG_SND_HDA_HWDEP
scripts/config --enable CONFIG_SND_HDA_RECONFIG
scripts/config --enable CONFIG_SND_HDA_CODEC_REALTEK # 汎用的に必要

scripts/config --enable CONFIG_PREEMPT

# ブラウザのサンドボックス機能に必須
scripts/config --enable CONFIG_USER_NS
scripts/config --enable CONFIG_SECCOMP
scripts/config --enable CONFIG_SECCOMP_FILTER
scripts/config --enable CONFIG_NAMESPACES

# 依存関係自動解決
make olddefconfig

# ---------- ここまで追加 ----------

echo 'make -j$(nproc)' >> kernelbuilder

echo 'make modules_install'>> kernelbuilder

chmod +x kernelbuilder

cat kernelbuilder

./kernelbuilder

cp -iv arch/x86/boot/bzImage /boot/vmlinuz-6.16.1-lfs-12.4-systemd

cp -iv System.map /boot/System.map-6.16.1

cp -iv .config /boot/config-6.16.1

if [[ "$ULFS_DOCS" == "YES" ]]
then

cp -r Documentation -T /usr/share/doc/linux-6.16.1

fi

install -v -m755 -d /etc/modprobe.d
cat > /etc/modprobe.d/usb.conf << "EOF"
# Begin /etc/modprobe.d/usb.conf

install ohci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i ohci_hcd ; true
install uhci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i uhci_hcd ; true

# End /etc/modprobe.d/usb.conf
EOF

