. /cscripts/env.sh

cd /sources

tar -xf bash-5.3.tar.gz

cd bash-5.3

# 1. 環境設定

./configure --prefix=/usr             \
            --without-bash-malloc     \
            --with-installed-readline \
            --docdir=/usr/share/doc/bash-5.3

# 2. シグナル定義の「種」を作る
# make mksignames
# ./mksignames signames.c

# 3. signames.o を「自前」でビルド (NSIG不足を補填)
# これを先に作っておくことで、次の make bash がこれを引用します
# gcc -DNSIG=70 -c signames.c -o signames.o

# 2. Makefile の修正 (sed を使用)
# 2-1. signames.c を自動生成するルールを無効化 (先頭に # を入れる)
sed -i 's/^signames.c:/#signames.c:/' Makefile

# 2-2. リンク対象 (OBJECTS) に signames.o を強制追加
# xmalloc.o の後ろに signames.o を差し込む
sed -i 's/xmalloc.o/xmalloc.o signames.o/' Makefile

# signames.c が不完全な場合、中身を強引に流し込む（ヒアドキュメント）
cat << 'EOF' > signames.c
#include <config.h>
#include <stdio.h>
#include <signal.h>
__attribute__((weak)) char *signal_names[NSIG + 4] = {
    "EXIT", "SIGHUP", "SIGINT", "SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS",
    "SIGFPE", "SIGKILL", "SIGUSR1", "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM",
    "SIGTERM", "SIGSTKFLT", "SIGCHLD", "SIGCONT", "SIGSTOP", "SIGTSTP", "SIGTTIN",
    "SIGTTOU", "SIGURG", "SIGXCPU", "SIGXFSZ", "SIGVTALRM", "SIGPROF", "SIGWINCH",
    "SIGIO", "SIGPWR", "SIGSYS", (char *)0x0
};
void initialize_signames () {}
EOF

# その後、手動でコンパイル
gcc -g -O2 -I. -I./include -I./lib -DNSIG=70 -c signames.c -o signames.o

# 4. 本体ビルド
# ターゲットを bash に絞ることで、ドキュメント生成エラーを回避
make -j1 bash

# 5. インストール
cp -v bash /usr/bin/bash
chown root:root /usr/bin/bash
chmod 755 /usr/bin/bash

# shリンクの作成
ln -svf bash /usr/bin/sh
