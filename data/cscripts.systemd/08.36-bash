. /cscripts/env.sh

cd /sources

tar -xf bash-5.3.tar.gz

cd bash-5.3

# 2. Configure (PIE関連のリンクエラーを回避するフラグを付与)
# LDFLAGS="-no-pie" は実行ファイルには有効ですが、loadables(共有ライブラリ)でコケるため
# ここではコンパイラに任せるか、環境に合わせた最小限の設定にします。
./configure --prefix=/usr             \
            --without-bash-malloc     \
            --with-installed-readline \
            --docdir=/usr/share/doc/bash-5.3

make mksignames
./mksignames signames.c
# signames.c が 0 バイトでないことを確認
ls -l signames.c

make -j1 bash

cp -v bash /usr/bin/bash
chown root:root /usr/bin/bash
chmod 755 /usr/bin/bash
ln -svf bash /usr/bin/sh
