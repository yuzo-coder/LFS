cd /sources
tar -xf dbus-1.16.2.tar.xz
cd dbus-1.16.2

# 1. ビルド前にユーザーとグループが確実に存在することを確認 (GID/UID 81)
# これを怠ると、インストール時のファイルの所有権が狂います
if ! getent group dbus >/dev/null; then
    groupadd -g 81 dbus
fi
if ! getent passwd dbus >/dev/null; then
    useradd -c "System Message Bus" -d /run/dbus -u 81 -g 81 -s /bin/false dbus
fi

# 2. ビルドディレクトリの作成
mkdir -v build
cd       build

# 3. Meson Setup (Sway/systemd完全対応版)
# ポイント: 
# - systemd=enabled (Combo型)
# - user_session=true (Boolean型)
# - runtime_dir=/run (現代的なパス)
meson setup .. \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    --wrap-mode=nofallback \
    -Druntime_dir=/run \
    -Dsystemd=enabled \
    -Dsystemd_system_unitdir=/usr/lib/systemd/system \
    -Dsystemd_user_unitdir=/usr/lib/systemd/user \
    -Duser_session=true \
    -Dselinux=disabled \
    -Dxml_docs=disabled \
    -Ddoxygen_docs=disabled \
    -Ddbus_user=dbus

# 4. コンパイル
ninja 

# 5. テスト (ULFS_TESTSがYESの場合)
if [[ "${ULFS_TESTS:-NO}" == "YES" ]]; then
    ninja test
fi

# 6. インストール
ninja install

# 7. 事後設定 (重要)
# 共有ライブラリのキャッシュを更新
ldconfig

# machine-id の作成 (前回の不整合を防ぐため)
# 手順: dbus-uuidgen で生成 -> /etc に配置 -> /var/lib/dbus にリンク
dbus-uuidgen --ensure
dbus-uuidgen > /etc/machine-id
mkdir -pv /var/lib/dbus
ln -sfv /etc/machine-id /var/lib/dbus/machine-id

# 8. クリーンアップ (任意)
# cd /sources
# rm -rf dbus-1.16.2





