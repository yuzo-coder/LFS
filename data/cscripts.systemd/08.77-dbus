cd /sources
# 既存のディレクトリがあれば削除してクリーンな状態から
rm -rf dbus-1.16.2
tar -xf dbus-1.16.2.tar.xz
cd dbus-1.16.2

# 1. ユーザーとグループの作成 (IDはBLFS標準の18を推奨)
if ! getent group dbus >/dev/null; then
    groupadd -g 18 dbus
fi
if ! getent passwd dbus >/dev/null; then
    useradd -c "System Message Bus" -d /var/run/dbus -u 18 -g dbus -s /bin/false dbus
fi

# 2. ビルドディレクトリ
mkdir -v build
cd build

# 3. Meson Setup
# -Dxml_docs=false, -Ddoxygen_docs=false (Mesonではdisabledではなくfalseの場合が多い)
meson setup .. \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Druntime_dir=/run \
    -Dsystemd=enabled \
    -Dsystemd_system_unitdir=/usr/lib/systemd/system \
    -Dsystemd_user_unitdir=/usr/lib/systemd/user \
    -Duser_session=true \
    -Dselinux=disabled \
    -Dxml_docs=disabled \
    -Ddoxygen_docs=disabled \
    -Ddbus_user=dbus

# 4. コンパイル
ninja 

# 5. インストール
ninja install

# 6. 【重要】実行権限の修正 (SUIDの設定)
# これを行わないと、特定のサービスが起動権限を持てません
chown -v root:dbus /usr/libexec/dbus-daemon-launch-helper
chmod -v 4750      /usr/libexec/dbus-daemon-launch-helper

# 7. 事後設定
ldconfig

# machine-id の確立
dbus-uuidgen --ensure=/etc/machine-id
mkdir -pv /var/lib/dbus
ln -sfv /etc/machine-id /var/lib/dbus/machine-id

