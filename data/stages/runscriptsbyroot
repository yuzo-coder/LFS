sudo chown -R lfs:lfs log
sudo chown -R lfs:lfs tmp

# このスクリプトが存在するディレクトリ（build）の絶対パスを取得
# これにより、どこから実行しても正しく "/home/user/LFS/build" を指します
SCRIPT_DIR=$(cd $(dirname $0); pwd)
# その親ディレクトリ（/home/user/LFS）
PARENT_DIR=$(dirname "$SCRIPT_DIR")
# ホームディレクトリ（/home/user）
MY_HOME=$(eval echo "~$(id -un 1000)") # UID 1000（通常最初のユーザー）のホームを取得

echo "Target Build Dir: $SCRIPT_DIR"
echo "Setting permissions..."

echo "MY_HOME: " "$MY_HOME"
echo "PARENT_DIR: " "$PARENT_DIR"
echo "SCRIPT_DIR: " "$SCRIPT_DIR"

# 1. 通り道の全ディレクトリに実行権限を付与
sudo chmod o+x "$MY_HOME"
sudo chmod o+x "$PARENT_DIR"
sudo chmod o+x "$SCRIPT_DIR"

# 2. 所有権を lfs に
sudo chown -R lfs:lfs "$SCRIPT_DIR"

# 3. lfs ユーザーとして実行
# cd 先を $SCRIPT_DIR に固定することで、間違いを防ぎます
su - lfs -c "cd $SCRIPT_DIR && time ./runscripts"

